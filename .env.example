# Environment Variables Template for Animal Mitra
# Copy this file to .env and fill in your actual values

# Django Core Settings
SECRET_KEY=your-django-secret-key-here-generate-new-one
DEBUG=True

# Database Configuration
# Leave empty for SQLite, or add PostgreSQL URL for production
DATABASE_URL=

# Email Configuration - Gmail SMTP
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-gmail-app-password

# Email Configuration - Resend API (Alternative)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Which email service to use? (gmail or resend)
EMAIL_SERVICE=gmail
